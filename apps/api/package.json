{
  "name": "@namoride/api",
  "version": "0.1.0",
  "private": true,
  "description": "Namo Ride backend API",
  "scripts": {
    "prebuild": "npm run prisma:generate",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.{json,ts}\"",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "db:status": "prisma migrate status"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "17.2.1",
    "helmet": "8.3.0",
    "mariadb": "3.5.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.0",
    "@types/node": "^24.0.0",
    "prettier": "3.9.6",
    "prisma": "7.10.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
