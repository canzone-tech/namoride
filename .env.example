# Local infrastructure
MYSQL_DATABASE=namoride
MYSQL_USER=namoride
MYSQL_PASSWORD=namoride_local_password
MYSQL_ROOT_PASSWORD=namoride_root_local_password
MYSQL_PORT=3306
REDIS_PORT=6379

# API
NODE_ENV=development
APP_VERSION=0.1.0
API_HOST=0.0.0.0
API_PORT=3000
DATABASE_URL=mysql://namoride:namoride_local_password@127.0.0.1:3306/namoride
DATABASE_CONNECTION_LIMIT=10
REDIS_URL=redis://127.0.0.1:6379
CORS_ORIGINS=http://localhost:3001
